#!/bin/bash
# 安装前准备：先拉镜像，再清理残留容器，最后等端口释放。
#
# 顺序说明：**先拉后清**。清理会把旧容器删掉，如果先清后拉而拉取失败
#（网络抖动、镜像还没推到 GHCR），设备上就既没容器也没镜像，应用直接不可用。
# 先拉能保证「新镜像没到手就什么都不动」。
#
# 镜像由 GitHub Actions 构建并推送到 ghcr.io/tarocats/apphub，
# 本机不再执行 docker build —— 这是「安装/更新极慢且容易失败」的根因。
#
# 任一步失败都不阻断安装（一律 exit 0，交给应用中心继续）。
set +e

APP_NAME="apphub"
PROJECT="apphub"
DEST="${TRIM_APPDEST:-/vol2/@appcenter/apphub}"
COMPOSE_FILE="${DEST}/docker/docker-compose.yaml"
IMAGE=""
REMOTE_IMAGE=""

# ---- 从 compose 读取容器名 / 项目名 / 镜像引用 ----
if [ -f "$COMPOSE_FILE" ]; then
    DETECTED=$(grep -E "^[[:space:]]*container_name" "$COMPOSE_FILE" | head -1 | awk -F ':' '{print $2}' | xargs)
    [ -n "$DETECTED" ] && APP_NAME="$DETECTED"
    DETECTED_PROJECT=$(grep -E "^[[:space:]]*name:" "$COMPOSE_FILE" | head -1 | awk -F ':' '{print $2}' | xargs)
    [ -n "$DETECTED_PROJECT" ] && PROJECT="$DETECTED_PROJECT"
    # 取 image: 后面的整串，兼容 ghcr.io/x/y:1.2.3 与 ${VAR:-latest}
    DETECTED_IMAGE=$(grep -E "^[[:space:]]*image:" "$COMPOSE_FILE" | head -1 | sed 's/^[[:space:]]*image:[[:space:]]*//' | xargs)
    case "$DETECTED_IMAGE" in
        *'${'*)
            _def=$(printf '%s' "$DETECTED_IMAGE" | sed -n 's/.*:-\([^}]*\)}.*/\1/p')
            _base=$(printf '%s' "$DETECTED_IMAGE" | sed 's/\${[^}]*}//')
            DETECTED_IMAGE="${_base}${_def:-latest}"
            ;;
    esac
    [ -n "$DETECTED_IMAGE" ] && IMAGE="$DETECTED_IMAGE"
fi

# 只有带仓库路径的才算远程镜像（apphub:1.0.26 这类本地构建镜像拉不到，别去 pull）
case "$IMAGE" in
    */*) REMOTE_IMAGE="$IMAGE" ;;
esac

if [ -f "${DEST}/config/resource" ]; then
    R=$(grep -oE '"name"[[:space:]]*:[[:space:]]*"[^"]+"' "${DEST}/config/resource" 2>/dev/null | head -1 | sed 's/.*"\([^"]*\)"$/\1/')
    [ -n "$R" ] && [ "$PROJECT" = "apphub" ] && PROJECT="$R"
fi

if ! command -v docker >/dev/null 2>&1; then
    exit 0
fi

wait_stopped() {
    _i=0
    while [ $_i -lt 30 ]; do
        _state=$(docker inspect -f '{{.State.Running}}' "$1" 2>/dev/null) || return 0
        [ "$_state" != "true" ] && return 0
        sleep 1
        _i=$((_i + 1))
    done
    return 1
}

remove_container() {
    _target="$1"
    docker inspect "$_target" >/dev/null 2>&1 || return 0
    # 1) 优雅停止（-t 20 超时后由 docker 强制终止）
    docker stop -t 20 "$_target" >/dev/null 2>&1
    # 2) 确认已退出，未退出则强杀，避免 rm 报 container is running
    if ! wait_stopped "$_target"; then
        docker kill "$_target" >/dev/null 2>&1
        wait_stopped "$_target"
    fi
    # 3) 删除容器；仍失败时兜底 -f
    docker rm "$_target" >/dev/null 2>&1 || docker rm -f "$_target" >/dev/null 2>&1
}

# ============ 第 1 步：拉取镜像 ============
# 安装阶段不清本地旧 tag（可能是上次装好的同版本，删了反而要重下）；
# 拉不到就沿用本地已有的，不阻断安装。
if [ -n "$REMOTE_IMAGE" ]; then
    _pulled=""
    for _try in 1 2 3; do
        if docker pull "$REMOTE_IMAGE" >/dev/null 2>&1; then
            _pulled="1"
            break
        fi
        sleep 3
    done
    if [ -z "$_pulled" ]; then
        # 指定版本拉不到时回退 latest，避免镜像 tag 尚未推送导致装不上
        _repo="${REMOTE_IMAGE%:*}"
        _latest="${_repo}:latest"
        for _try in 1 2; do
            if docker pull "$_latest" >/dev/null 2>&1; then
                _pulled="1"
                # compose 里指向不存在的版本 tag 会导致启动失败，改写为 latest
                # 用临时文件改写，兼容 busybox sed（不支持 -i 无参数形式）
                if [ -f "$COMPOSE_FILE" ]; then
                    sed "s|^\([[:space:]]*image:[[:space:]]*\)${_repo}:[^[:space:]]*|\1${_latest}|" \
                        "$COMPOSE_FILE" > "${COMPOSE_FILE}.tmp" 2>/dev/null \
                        && mv "${COMPOSE_FILE}.tmp" "$COMPOSE_FILE" 2>/dev/null
                    rm -f "${COMPOSE_FILE}.tmp" 2>/dev/null
                fi
                break
            fi
            sleep 3
        done
    fi
fi

# ============ 第 2 步：清理残留容器 ============
# 按容器名清理：直接按名字 inspect 一次，再用 ps 名字过滤兜底
# （报错里出现过 " /apphub" 这种带前导斜杠的脏名，直接 inspect 可能匹配不到）
remove_container "$APP_NAME"
remove_container "/${APP_NAME}"
for cid in $(docker ps -aq --filter "name=^/?${APP_NAME}$" 2>/dev/null); do
    remove_container "$cid"
done

# 按 compose 项目标签：新项目名 + 历史遗留的目录名项目（去重后逐个清理）
_projects=$(printf '%s\n' "$PROJECT" "apphub" "docker" | awk 'NF && !seen[$0]++')
for _proj in $_projects; do
    for cid in $(docker ps -aq --filter "label=com.docker.compose.project=${_proj}" 2>/dev/null); do
        remove_container "$cid"
    done
done

# 按镜像兜底：GHCR 镜像的历史版本与早期本地构建的 apphub 镜像
for _ref in "ghcr.io/tarocats/apphub" "apphub" "${APP_NAME}:latest"; do
    for cid in $(docker ps -aq --filter "ancestor=${_ref}" 2>/dev/null); do
        remove_container "$cid"
    done
done

# ============ 第 3 步：等端口释放 ============
PORT=$(grep -E "APPHUB_PORT" "$COMPOSE_FILE" 2>/dev/null | head -1 | grep -oE "[0-9]{2,5}" | head -1)
[ -n "$PORT" ] || PORT=9080
_i=0
while [ $_i -lt 15 ]; do
    _busy=""
    if command -v ss >/dev/null 2>&1; then
        ss -ltn 2>/dev/null | grep -q ":${PORT} " && _busy="1"
    elif command -v netstat >/dev/null 2>&1; then
        netstat -ltn 2>/dev/null | grep -q ":${PORT} " && _busy="1"
    fi
    [ -z "$_busy" ] && break
    sleep 1
    _i=$((_i + 1))
done

exit 0
