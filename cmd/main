#!/bin/bash
# AppHub 生命周期脚本：容器由应用中心启动，这里只负责状态上报。

FILE_PATH="${TRIM_APPDEST}/docker/docker-compose.yaml"
DOCKER_NAME="apphub"

if [ -f "$FILE_PATH" ]; then
    DETECTED=$(grep -E "^\s*container_name" "$FILE_PATH" | head -1 | awk -F ':' '{print $2}' | xargs)
    [ -n "$DETECTED" ] && DOCKER_NAME="$DETECTED"
fi

is_docker_running () {
    docker inspect -f '{{.State.Running}}' "$DOCKER_NAME" 2>/dev/null | grep -q "true"
}

case $1 in
start)
    exit 0
    ;;
stop)
    exit 0
    ;;
status)
    if is_docker_running; then
        exit 0
    else
        exit 3
    fi
    ;;
*)
    exit 1
    ;;
esac
