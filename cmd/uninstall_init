#!/bin/bash
# 卸载前清理：容器 + 本项目镜像 + compose 项目记账，避免卸载后残留占用 9080。
# 数据目录 / 数据共享（apphub.db）不在这里删，由应用中心按 data-share 声明处理。
set +e

APP_NAME="apphub"
PROJECT="apphub"
DEST="${TRIM_APPDEST:-/vol2/@appcenter/apphub}"
COMPOSE_FILE="${DEST}/docker/docker-compose.yaml"

if [ -f "$COMPOSE_FILE" ]; then
    DETECTED=$(grep -E "^[[:space:]]*container_name" "$COMPOSE_FILE" | head -1 | awk -F ':' '{print $2}' | xargs)
    [ -n "$DETECTED" ] && APP_NAME="$DETECTED"
    DETECTED_PROJECT=$(grep -E "^[[:space:]]*name:" "$COMPOSE_FILE" | head -1 | awk -F ':' '{print $2}' | xargs)
    [ -n "$DETECTED_PROJECT" ] && PROJECT="$DETECTED_PROJECT"
fi

if [ -f "${DEST}/config/resource" ]; then
    R=$(grep -oE '"name"[[:space:]]*:[[:space:]]*"[^"]+"' "${DEST}/config/resource" 2>/dev/null | head -1 | sed 's/.*"\([^"]*\)"$/\1/')
    [ -n "$R" ] && [ "$PROJECT" = "apphub" ] && PROJECT="$R"
fi

if ! command -v docker >/dev/null 2>&1; then
    exit 0
fi

wait_stopped() {
    _i=0
    while [ $_i -lt 30 ]; do
        _state=$(docker inspect -f '{{.State.Running}}' "$1" 2>/dev/null) || return 0
        [ "$_state" != "true" ] && return 0
        sleep 1
        _i=$((_i + 1))
    done
    return 1
}

remove_container() {
    _target="$1"
    docker inspect "$_target" >/dev/null 2>&1 || return 0
    docker stop -t 20 "$_target" >/dev/null 2>&1
    if ! wait_stopped "$_target"; then
        docker kill "$_target" >/dev/null 2>&1
        wait_stopped "$_target"
    fi
    docker rm "$_target" >/dev/null 2>&1 || docker rm -f "$_target" >/dev/null 2>&1
}

# ---- 1) 优先让 compose 自己 down（连网络、孤儿容器一起收） ----
if [ -f "$COMPOSE_FILE" ]; then
    if command -v docker-compose >/dev/null 2>&1; then
        (cd "$(dirname "$COMPOSE_FILE")" && docker-compose -p "$PROJECT" down --remove-orphans --volumes) >/dev/null 2>&1
    fi
    (cd "$(dirname "$COMPOSE_FILE")" && docker compose -p "$PROJECT" down --remove-orphans --volumes) >/dev/null 2>&1
fi

# ---- 2) 容器兜底清理 ----
# 直接按名字 inspect 一次，再用 ps 名字过滤兜底
# （报错里出现过 " /apphub" 这种带前导斜杠的脏名，直接 inspect 可能匹配不到）
remove_container "$APP_NAME"
remove_container "/${APP_NAME}"
for cid in $(docker ps -aq --filter "name=^/?${APP_NAME}$" 2>/dev/null); do
    remove_container "$cid"
done

# 项目名去重后逐个清理（新项目名可能就是 apphub，避免同一批容器被扫两遍）
_projects=$(printf '%s\n' "$PROJECT" "apphub" "docker" | awk 'NF && !seen[$0]++')
for _proj in $_projects; do
    for cid in $(docker ps -aq --filter "label=com.docker.compose.project=${_proj}" 2>/dev/null); do
        remove_container "$cid"
    done
done

for _ref in "ghcr.io/tarocats/apphub" "apphub"; do
    for cid in $(docker ps -aq --filter "ancestor=${_ref}" 2>/dev/null); do
        remove_container "$cid"
    done
done

# ---- 3) 删除本项目镜像（含历史本地构建的 apphub:*) ----
for _img in $(docker images --format '{{.Repository}}:{{.Tag}}' 2>/dev/null | grep -E '^(ghcr\.io/tarocats/apphub|apphub):' ); do
    docker image rm "$_img" >/dev/null 2>&1 || docker image rm -f "$_img" >/dev/null 2>&1
done

exit 0
